# 服务监听（默认 8787 + 127.0.0.1；若 listen EACCES 请换 PORT）
PORT=8787
HOST=127.0.0.1

# SQLite 路径（默认 server/data/club_scheduler.sqlite）
# SCHEDULER_DB_PATH=E:\byerun\server\data\club_scheduler.sqlite

# Token 加密（生产必须设置其一，见 backend-club-sign-scheduler.md）
# 64 位十六进制 = 32 字节 AES 密钥
# SCHEDULER_ENCRYPTION_KEY=
# 或使用口令派生密钥
# SCHEDULER_MASTER_PASSWORD=

# 查询今日执行日志：GET /api/club-schedules/runs/today 请求头 X-Scheduler-Admin
# SCHEDULER_ADMIN_SECRET=

# 校园跑 API（默认官方）
# BYERUN_API_BASE=https://run-lb.tanmasports.com/v1
# BYERUN_APP_KEY=
# BYERUN_APP_SECRET=
